# Optional when the React client and API use the same published URL. Set this
# only for a separate trusted frontend, for example https://attendance.example.edu
APP_URL=

# Used only when a brand-new production data disk is created. Do not use a
# default password; choose a unique password of at least 12 characters.
INITIAL_ADMIN_USERNAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Persistent storage supplied by the host. Render blueprint uses /var/data.
DATA_DIR=/var/data
PYTHON_EXECUTABLE=/usr/bin/python3

# Required only for the Oracle VM Docker Compose deployment. This must be a
# DNS name pointing to the VM's public IP; do not use an IP address here.
APP_DOMAIN=attendance.example.org
